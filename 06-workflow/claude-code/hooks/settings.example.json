{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python -X utf8 \"${CLAUDE_PROJECT_DIR}/06-workflow/claude-code/hooks/session_status.py\"",
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python -X utf8 \"${CLAUDE_PROJECT_DIR}/06-workflow/claude-code/hooks/doc_guard.py\"",
            "timeout": 15,
            "statusMessage": "문서 금지 문자 검사"
          }
        ]
      }
    ]
  }
}
